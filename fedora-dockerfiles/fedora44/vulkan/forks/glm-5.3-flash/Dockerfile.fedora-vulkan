FROM fedora:44

# ──────────────────────────────────────────────
# 1. Base build dependencies + confirmed runtime GPU libs
#    Package names verified against packages.fedoraproject.org/fedora-44
# ──────────────────────────────────────────────
RUN dnf update -y && \
    dnf install -y \
      git \
      cmake \
      make \
      gcc \
      gcc-c++ \
      python3 \
      python3-flask \
      wget \
      # Runtime: Vulkan ICD loader
      vulkan-loader \
      # Runtime: Mesa RADV Vulkan driver (provides libvulkan_radeon.so)
      # and radeon_icd.x86_64.json — without this loader finds zero ICDs
      mesa-vulkan-drivers \
      # Runtime: DRI/gallium base drivers (required by mesa-vulkan-drivers)
      mesa-dri-drivers \
      # Runtime: libglvnd stack — correct Fedora 44 package names
      libglvnd \
      libglvnd-egl \
      mesa-libGL \
      mesa-libEGL \
      # Runtime: DRM userspace lib
      libdrm && \
    dnf clean all

# ──────────────────────────────────────────────
# 2. LunarG Vulkan SDK (build-time toolchain only)
# ──────────────────────────────────────────────
ARG VULKAN_SDK_VERSION=1.4.341.1

RUN wget -q \
      https://sdk.lunarg.com/sdk/download/${VULKAN_SDK_VERSION}/linux/vulkansdk-linux-x86_64-${VULKAN_SDK_VERSION}.tar.xz \
      -O /tmp/vulkansdk.tar.xz && \
    mkdir -p /opt/vulkan-sdk && \
    tar -xf /tmp/vulkansdk.tar.xz -C /opt/vulkan-sdk && \
    rm /tmp/vulkansdk.tar.xz

ENV VULKAN_SDK=/opt/vulkan-sdk/${VULKAN_SDK_VERSION}/x86_64
ENV PATH="${VULKAN_SDK}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${VULKAN_SDK}/lib"
ENV VK_ADD_LAYER_PATH="${VULKAN_SDK}/share/vulkan/explicit_layer.d"
ENV PKG_CONFIG_PATH="${VULKAN_SDK}/lib/pkgconfig"

# ──────────────────────────────────────────────
# 3. Clone and build llama.cpp with Vulkan backend
#    GLM-5.3-Flash (glm5next) support from PR ggml-org/llama.cpp#27754
# ──────────────────────────────────────────────
ARG LLAMA_CPP_REPO=https://github.com/unslothai/llama.cpp.git
ARG LLAMA_CPP_BRANCH=glm5next/upstream
# FlashAttention KV cache quantization: llama.cpp defaults to only f16/q4_0/q8_0/bf16 unless enabled
ARG GGML_CUDA_FA_ALL_QUANTS=ON
ARG CMAKE_EXTRA_FLAGS=""

RUN git clone ${LLAMA_CPP_REPO} /llama.cpp && \
    cd /llama.cpp && \
    git checkout ${LLAMA_CPP_BRANCH}

WORKDIR /llama.cpp
RUN mkdir build

WORKDIR /llama.cpp/build
RUN cmake .. \
      -DGGML_VULKAN=ON \
      -DCMAKE_BUILD_TYPE=Release \
      -DLLAMA_CURL=OFF \
      -DGGML_CUDA_FA_ALL_QUANTS=${GGML_CUDA_FA_ALL_QUANTS} \
      -DVulkan_INCLUDE_DIR=${VULKAN_SDK}/include \
      -DVulkan_LIBRARY=${VULKAN_SDK}/lib/libvulkan.so \
      -DBUILD_SHARED_LIBS=OFF \
      -DCMAKE_C_FLAGS="-DGGML_SCHED_MAX_SPLIT_INPUTS=64" \
      -DCMAKE_CXX_FLAGS="-DGGML_SCHED_MAX_SPLIT_INPUTS=64" \
      ${CMAKE_EXTRA_FLAGS} && \
    make -j$(nproc)

# ──────────────────────────────────────────────
# 4. Stage binaries
# ──────────────────────────────────────────────
RUN cp /llama.cpp/build/bin/llama-server /llama.cpp/

WORKDIR /llama.cpp
